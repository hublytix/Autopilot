# Hublytix Autopilot environment (PLAN §14). Copy to .env.local; never commit real values.
# src/server/env.ts validates everything on first use. APP_MODE=fake needs nothing else: every
# unset variable gets a documented fake value (FAKE_ENV in env.ts), which live mode refuses.
# In live mode every variable without a default below is required and checked.
# Generate 32-byte keys with: openssl rand -base64 32

# --- App ---------------------------------------------------------------------------------------
# Required: fake (no credentials, local fakes) or live (real services).
APP_MODE=fake
# Set to 1 only to allow fake mode on a Vercel production/preview deployment (refused otherwise; needs Vercel deployment protection over /dev).
# Fake mode that others can reach (Vercel, or a non-loopback APP_URL) needs real values for APP_SECRET, TOKEN_ENCRYPTION_KEY,
# HUBSPOT_CLIENT_SECRET, QSTASH_CURRENT_SIGNING_KEY, QSTASH_NEXT_SIGNING_KEY and CRON_SECRET: the fake ones are public.
ALLOW_FAKE_ON_VERCEL=
# Public origin of the app, no trailing path (live: https). Fake default http://localhost:3000.
APP_URL=
# Display name; also exposed to the browser as NEXT_PUBLIC_PRODUCT_NAME. Default: Hublytix Autopilot.
PRODUCT_NAME=
# HKDF root for per-purpose keys (state, pending, ratelimit, dedupe, fake-session): base64, 32 bytes.
APP_SECRET=
# AES-256-GCM key for HubSpot tokens at rest: base64, 32 bytes; must differ from APP_SECRET.
TOKEN_ENCRYPTION_KEY=
# Previous token key during rotation: decrypt only, must differ from the current key. Optional.
TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Comma-separated admin email addresses (access to /admin and admin alerts).
ADMIN_EMAILS=
# Prefix for every job dedupe and email idempotency key; unique per environment (e.g. prod, preview).
ENV_NAMESPACE=
# Longest compose URL before falling back to the copy page. Default: 1800.
COMPOSE_URL_LIMIT=
# Gmail compose link form: u (…/mail/u/{n}/?…&tf=cm) or view. Default: u.
COMPOSE_GMAIL_FORM=
# Outlook compose link mode: mailtouri or params. Default: mailtouri.
COMPOSE_OUTLOOK_MODE=
# Outlook work/school compose base URL. Default: https://outlook.cloud.microsoft/mail/deeplink/compose
COMPOSE_OUTLOOK_WORK_BASE=
# Outlook.com compose base URL. Default: https://outlook.live.com/mail/deeplink/compose
COMPOSE_OUTLOOK_PERSONAL_BASE=
# Per-account daily cap on drafted leads. Default: 50.
MAX_DRAFTED_LEADS_PER_DAY=
# Global daily AI spend breaker in USD. Default: 25.
AI_DAILY_BUDGET_USD=
# Fake mode only: PGlite data directory. Default: .data/pglite.
FAKE_DB_DIR=

# --- Database / auth (all server-only) ----------------------------------------------------------
# Supabase transaction pooler URL (port 6543); contains the database password.
DATABASE_URL=
# Supabase project URL (https://<ref>.supabase.co).
SUPABASE_URL=
# Supabase publishable key (sb_publishable_…); server-only here.
SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_…); bypasses RLS, server-only.
SUPABASE_SECRET_KEY=

# --- HubSpot -----------------------------------------------------------------------------------
# App client id (a UUID) from the HubSpot developer project.
HUBSPOT_CLIENT_ID=
# App client secret; also verifies webhook signatures.
HUBSPOT_CLIENT_SECRET=
# Previous client secret during rotation: webhook verification only. Optional.
HUBSPOT_CLIENT_SECRET_PREVIOUS=
# Numeric app id; webhooks for any other app id are dropped.
HUBSPOT_APP_ID=
# OAuth redirect URI, on the APP_URL origin: <APP_URL>/api/hubspot/oauth/callback
HUBSPOT_REDIRECT_URI=
# Exact webhook target URL configured in the app (signatures are computed over it).
HUBSPOT_WEBHOOK_TARGET_URL=
# Date-versioned API version. Default: 2026-09.
HUBSPOT_API_VERSION=
# Webhooks Journal polling (designed, off): true or false. Default: false.
HUBSPOT_JOURNAL_ENABLED=

# --- QStash / cron -----------------------------------------------------------------------------
# Region-specific QStash URL, copied from the console for the token's region.
QSTASH_URL=
# QStash token (publishing).
QSTASH_TOKEN=
# QStash current signing key (sig_…).
QSTASH_CURRENT_SIGNING_KEY=
# QStash next signing key (sig_…).
QSTASH_NEXT_SIGNING_KEY=
# Longest single QStash delay before a hop message. Default: 601200 (7 days minus 1 hour).
QSTASH_MAX_DELAY_SECONDS=
# Bearer secret for Vercel Cron: at least 32 visible ASCII characters (openssl rand -hex 32).
CRON_SECRET=
# Never set QSTASH_DEV here: live mode refuses it (it swaps in public dev signing keys).
# Never set QSTASH_REGION or region-prefixed QStash variables (US_EAST_1_QSTASH_*, EU_CENTRAL_1_QSTASH_*): live mode refuses them.

# --- Email -------------------------------------------------------------------------------------
# Resend API key (re_…), sending access for the app domain.
RESEND_API_KEY=
# Sender: an address or "Name <address>" on the verified domain.
EMAIL_FROM=
# Reply-To for magic-link and billing emails only.
EMAIL_REPLY_TO=

# --- AI ----------------------------------------------------------------------------------------
# Anthropic API key (sk-ant-…).
ANTHROPIC_API_KEY=
# Draft and brief model. Default: claude-sonnet-5-5.
ANTHROPIC_MODEL_DRAFT=
# Classification model. Default: claude-haiku-4-5-20251001.
ANTHROPIC_MODEL_FAST=
# Draft thinking mode: between_tools or adaptive. Default: between_tools.
ANTHROPIC_DRAFT_THINKING=
# Draft effort: low, medium, high, xhigh or max (xhigh and max need ANTHROPIC_DRAFT_THINKING=adaptive). Default: medium.
ANTHROPIC_DRAFT_EFFORT=
# Draft max_tokens. Default: 1024.
ANTHROPIC_DRAFT_MAX_TOKENS=
# Brief effort (first attempt): low, medium, high, xhigh or max. Default: high.
ANTHROPIC_BRIEF_EFFORT=
# Never set ANTHROPIC_CUSTOM_HEADERS: live mode refuses it (the SDK would add it to every request).

# --- Billing -----------------------------------------------------------------------------------
# Razorpay key id: rzp_test_… or rzp_live_… (rzp_live_ required on Vercel production).
RAZORPAY_KEY_ID=
# Razorpay key secret (same key generation as the key id).
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret.
RAZORPAY_WEBHOOK_SECRET=
# Previous webhook secret during rotation: verification only. Optional.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# Razorpay plan id (plan_…) for the monthly subscription.
RAZORPAY_PLAN_ID=

# --- Sentry (optional; without a DSN Sentry is a no-op) -----------------------------------------
# Server and edge DSN (https://<key>@<host>/<project id>).
SENTRY_DSN=
# Browser DSN; the only public value besides the product name. Browser Sentry never runs on /a/* or /auth/*.
NEXT_PUBLIC_SENTRY_DSN=
# Build only: organisation slug for source-map upload.
SENTRY_ORG=
# Build only: project slug for source-map upload.
SENTRY_PROJECT=
# Build only: auth token; source maps are uploaded only when it is set. Never NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=
# Never set SENTRY_TRACES_SAMPLE_RATE: Sentry runs errors-only and live mode refuses it.
# Never set SENTRY_SPOTLIGHT or SENTRY_DEBUG: live mode refuses them.
