      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": [],
      "iframe": [],
      "img": []
    },
    "support": {
      "supportEmail": "support@autopilot.example.com",
      "documentationUrl": "https://autopilot.example.com/privacy",
      "supportUrl": "https://autopilot.example.com/"
    }
  }
}
